# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and cluster details with your Atlas credentials
# Example: mongodb+srv://myUser:myPassword@cluster0.abcde.mongodb.net/mvcon2027?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mvcon2027?retryWrites=true&w=majority

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000

# JWT Secret (for authentication tokens)
JWT_SECRET=mvcon2027_super_secret_jwt_key_development_only
JWT_EXPIRE=7d

# Admin Credentials
ADMIN_EMAIL=admin@mvcon.in
ADMIN_PASSWORD="your-admin-password"

# SMTP Email Configuration (Hostinger / Custom Domain)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=admin@mvcon.in
SMTP_PASS="your-smtp-password"
EMAIL_FROM="MVCON 2027" <admin@mvcon.in>
